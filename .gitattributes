# Normalize text files to LF in the repository and in working trees.
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
*.cfg   text eol=lf
Dockerfile text eol=lf
daemons text eol=lf

*.png   binary
*.gif   binary
*.jpg   binary
*.mp4   binary
*.eot   binary
*.ttf   binary
*.woff  binary
